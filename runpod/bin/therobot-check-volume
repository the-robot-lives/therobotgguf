#!/usr/bin/env bash
set -euo pipefail

data_dir="${THEROBOT_DATA:-/workspace/data}"

echo "THEROBOT_DATA=${data_dir}"

if [[ ! -d "$data_dir" ]]; then
  echo "ERROR: ${data_dir} does not exist. Mount the RunPod volume there or run therobot-init-volume." >&2
  exit 1
fi

echo
df -h "$data_dir"

echo
for dir in llms corpus hf-cache work; do
  path="${data_dir}/${dir}"
  if [[ -d "$path" ]]; then
    size="$(du -sh "$path" 2>/dev/null | awk '{print $1}')"
    echo "ok      ${path} (${size})"
  else
    echo "missing ${path}"
  fi
done

echo
for bin in robotgguf llama-cli llama-server llama-quantize; do
  if command -v "$bin" >/dev/null 2>&1; then
    echo "ok      ${bin}: $(command -v "$bin")"
  else
    echo "missing ${bin}"
  fi
done
